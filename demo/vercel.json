{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kcsastudio.com" }],
      "destination": "https://kcsastudio.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kcsa-studio.vercel.app" }],
      "destination": "https://kcsastudio.com/:path*",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/",
      "permanent": true
    }
  ]
}
